#!/usr/bin/env python3
"""Legacy read-only report entrypoint; use the same evidence as native guards.

Always emits JSON. --no-fetch remains accepted for compatibility: no invocation
fetches or mutates refs. --base is retired because the actual target PR supplies
its base; refusing overrides prevents a report against the wrong branch.
"""
import json
import os
import sys
from workflow_conflicts import report


def main():
    args = [arg for arg in sys.argv[1:] if arg != '--no-fetch']
    if args:
        result = dict(gh_ok=False, conflicts=[], warnings=[
            'Unsupported arguments. The selected repository/review determines the base; '
            'refresh refs explicitly before checking.'])
    else:
        result = report(os.getcwd())
    print(json.dumps(result, indent=2))
    return 0


if __name__ == '__main__':
    sys.exit(main())
