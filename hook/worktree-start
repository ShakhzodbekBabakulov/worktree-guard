#!/usr/bin/env python3
"""Create/resume isolated feature work; optionally name an existing native worktree."""
import argparse
import os
from pathlib import Path
from worktree_common import Stop, base_branch, clean, entry, git, is_linked, root, run, trees


def exists(here, name):
    return run(['git', 'show-ref', '--verify', '--quiet', name], here, False).returncode == 0


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('name', help='exact feature branch name')
    ap.add_argument('--path', help='destination for a new worktree')
    ap.add_argument('--adopt', action='store_true', help='name this already isolated detached worktree, preserving changes')
    opts = ap.parse_args()
    here = root(os.getcwd())
    git(here, 'check-ref-format', '--branch', opts.name)
    base = base_branch(here)
    if opts.name in {base, 'main', 'master'}:
        raise Stop('Choose a feature branch name, not a protected branch.')
    # Record the resolved default for read-only edit hooks, including repositories
    # initially created with git init + remote add instead of git clone.
    git(here, 'symbolic-ref', 'refs/remotes/origin/HEAD', 'refs/remotes/origin/' + base)
    registered = trees(here)
    matching = [t for t in registered if t.get('branch') == 'refs/heads/' + opts.name]
    if opts.adopt:
        if opts.path:
            raise Stop('--adopt cannot create a different directory.')
        branch = git(here, 'branch', '--show-current')
        if branch == opts.name and is_linked(here):
            print('Resuming branch: ' + branch + '\nWork in: ' + str(here))
            return
        if branch or not is_linked(here):
            raise Stop('--adopt requires a registered isolated detached worktree.')
        if matching or exists(here, 'refs/heads/' + opts.name):
            raise Stop('That branch already exists; choose a unique name for this native worktree.')
        # Creating a ref at HEAD preserves staged, unstaged, and untracked work.
        git(here, 'switch', '-c', opts.name)
        print('Named native worktree: ' + opts.name + '\nWork in: ' + str(here))
        return
    if matching:
        if len(matching) != 1 or 'prunable' in matching[0] or 'locked' in matching[0]:
            raise Stop('The existing workspace is missing or locked; inspect it before resuming.')
        target = Path(matching[0]['worktree']).resolve()
        if opts.path and Path(opts.path).expanduser().resolve() != target:
            raise Stop('This branch already has a workspace: ' + str(target))
        print('Resuming existing worktree.\nBranch: ' + opts.name + '\nWork in: ' + str(target))
        print('Existing files were preserved; verify the host task is using this directory.')
        return
    clean(here)
    primary = Path(registered[0]['worktree']).resolve()
    # Produce a folder name; an existing path always stops creation.
    target = Path(opts.path).expanduser().resolve() if opts.path else (
        primary.parent / (primary.name + '-worktrees') / opts.name.replace('/', '--'))
    if target.exists():
        raise Stop('The target directory already exists: ' + str(target))
    if target.is_relative_to(primary) or any(target.is_relative_to(Path(t['worktree']).resolve()) for t in registered):
        raise Stop('Place a new worktree outside existing project/worktree directories.')
    git(here, 'fetch', '--prune', 'origin')
    git(here, 'remote', 'set-head', 'origin', '--auto')
    base = base_branch(here)
    if opts.name in {base, 'main', 'master'}:
        raise Stop('The remote default changed; choose a feature branch name.')
    if exists(here, 'refs/heads/' + opts.name):
        git(here, 'worktree', 'add', str(target), opts.name)
    elif exists(here, 'refs/remotes/origin/' + opts.name):
        git(here, 'worktree', 'add', '--track', '-b', opts.name, str(target), 'refs/remotes/origin/' + opts.name)
    else:
        git(here, 'worktree', 'add', '--no-track', '-b', opts.name, str(target), 'refs/remotes/origin/' + base)
    print('Ready branch: ' + opts.name + '\nWork in: ' + str(target))
    print('The original checkout was not switched. Verify the host task location before coding.')


if __name__ == '__main__':
    entry(main)
